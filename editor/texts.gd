## Paramètres de l'éditeur (posés par plugin.gd).
static var settings: EditorSettings = null


static func t(key: String) -> String:
	var table: Dictionary = TEXTS.get(language(), TEXTS["en"])
	return table.get(key, TEXTS["en"].get(key, key))


## Texte avec ses arguments ; seuls les premiers servent si le texte a moins
## de trous que d'arguments.
static func tf(key: String, args: Array) -> String:
	var text: String = t(key)
	var holes: int = text.count("%") - 2 * text.count("%%")
	if args.is_empty() or holes <= 0:
		return text
	return text % args.slice(0, holes)


static func language() -> String:
	if settings == null or not settings.has_setting(SETTING):
		return LANGUAGES[0]
	return LANGUAGES[clampi(int(settings.get_setting(SETTING)), 0, LANGUAGES.size() - 1)]


## Déclare le réglage de langue dans les paramètres de l'éditeur.
static func register_setting(editor_settings: EditorSettings) -> void:
	settings = editor_settings
	if not settings.has_setting(SETTING):
		settings.set_setting(SETTING, 0)
	settings.set_initial_value(SETTING, 0, false)
	settings.add_property_info({"name": SETTING, "type": TYPE_INT,
		"hint": PROPERTY_HINT_ENUM, "hint_string": "English,Français"})
